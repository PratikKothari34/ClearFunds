# Copy to .env. Never commit the real value: it derives every admin signing key.
# Generate with: openssl rand -hex 32
CLEARFUNDS_SIGNING_SECRET=
# Origin allowed to call the function from a browser (default *).
CLEARFUNDS_ALLOWED_ORIGIN=http://127.0.0.1:5173
# Enrolment mail. Gmail: smtp.gmail.com, 465, the account, an app password.
# Locally, Mailpit: host supabase_inbucket_clearfunds, port 1025, no user.
CLEARFUNDS_SMTP_HOST=
CLEARFUNDS_SMTP_PORT=465
CLEARFUNDS_SMTP_USER=
CLEARFUNDS_SMTP_PASS=
CLEARFUNDS_SMTP_FROM=
# Shared with the cron job through Vault (clearfunds_mailer_secret).
CLEARFUNDS_MAILER_SECRET=
# The monthly published chain head (backend/README.md). Shared with the cron
# job through Vault (clearfunds_anchor_secret). Nothing publishes until the
# repo and token are set.
CLEARFUNDS_ANCHOR_SECRET=
CLEARFUNDS_ANCHOR_REPO=
CLEARFUNDS_ANCHOR_TOKEN=
